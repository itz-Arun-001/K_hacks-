# ==============================================================================
# SafeLoop Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR SECRETS (DO NOT COMMIT .env TO GIT)
# ==============================================================================

# Database Connection (Switch between SQLite local or Neon PostgreSQL)
# Local SQLite fallback:
DATABASE_URL=sqlite:///./safeloop.db
# Neon PostgreSQL shared team DB:
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/safeloop?sslmode=require

# Twilio WhatsApp Sandbox (Person 1 & 2)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# LLM API (Gemini or OpenAI) (Person 1 & 4)
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Threat Intelligence & Link Checks (Person 1)
SAFE_BROWSING_API_KEY=your_safe_browsing_key_here
VIRUSTOTAL_API_KEY=your_virustotal_key_here

# Server Settings
APP_ENV=development
APP_PORT=8000
SECRET_KEY=change_this_to_a_random_secret_in_production
